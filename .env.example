# Deployment Environment Variables Example

# Application Setup
DEBUG=False
CORS_ORIGINS=["https://your-vercel-app.vercel.app", "http://localhost:5173"]

# Security
# Generate a secure key using `openssl rand -hex 32` or similar
SECRET_KEY=super-secret-production-key-change-me
ALGORITHM=HS256

# Database (Neon.tech)
# Make sure to append ?sslmode=require if connecting from outside platforms
DATABASE_URL=postgresql://[user]:[password]@ep-restless-bird-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Email (Brevo / Resend)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email@domain.com
SMTP_PASSWORD=your-brevo-smtp-key
MAIL_FROM=noreply@placeshare.com
